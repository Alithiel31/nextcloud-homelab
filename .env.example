# Copier ce fichier en .env et remplir. Ne JAMAIS commiter .env (ignoré par .gitignore).

# IP Tailscale de Caesura et nom Tailscale complet de la machine
TAILSCALE_IP=100.x.y.z
TS_HOST=caesura.<tailnet>.ts.net

# Mailpit mutualisé (projet mailpit/) : IP Tailscale, port 1025
SMTP_HOST=100.x.y.z
SMTP_PORT=1025

# Version majeure de Nextcloud (vérifier la dernière stable avant le premier déploiement)
NEXTCLOUD_VERSION=32
NEXTCLOUD_PORT=8180
PHP_UPLOAD_LIMIT=4G

# Dossiers du disque à consulter (montés en lecture seule). Ne jamais monter tout /mnt/storage.
DISK_DOCUMENTS="/mnt/storage/Documents"
DISK_MUSIC="/mnt/storage/Music"
DISK_PHOTOS="/mnt/storage/Photos"

# Dossier des données Nextcloud, sur le disque (pas sur la SD). À créer : chown 33:33, chmod 750.
DATA_PATH=/mnt/storage/nextcloud-data

# Compte admin initial
NEXTCLOUD_ADMIN_USER=admin

# Secrets : à placer dans Infisical (comme les autres projets), ou ici en dernier recours
# NEXTCLOUD_DB_PASS=
# NEXTCLOUD_ADMIN_PASSWORD=
