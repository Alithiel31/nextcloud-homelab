# Copier ce fichier en .infisical-identity.env (jamais commite, voir .gitignore).
# Identifiants de la Machine Identity "nextcloud-deploy" creee dans Infisical
# (Shared Keys > Access Control > Machine Identities).

INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=changeme
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=changeme

# ID du projet Infisical « Shared Keys » (Project Settings > Project ID).
INFISICAL_PROJECT_ID=changeme

# URL d'Infisical : nom interne (Traefik + DNS interne) ou adresse Tailscale directe.
# INFISICAL_API_URL=http://<hostname>.<tailnet>.ts.net:8090
INFISICAL_API_URL=http://vault.caesura.internal
